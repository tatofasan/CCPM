// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Core User Management
// ============================================================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relations
  dropshipperProfile         DropshipperProfile?
  orderEventsChanged         OrderEvent[]        @relation("ChangedBy")
  walletTransactionsCreated  WalletTransaction[] @relation("CreatedBy")
  depositRequestsReviewed    DepositRequest[]    @relation("ReviewedBy")
  withdrawalRequestsReviewed WithdrawalRequest[] @relation("ReviewedBy")

  @@map("users")
}

enum UserRole {
  ADMIN
  DROPSHIPPER
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model DropshipperProfile {
  id              String    @id @default(cuid())
  userId          String    @unique @map("user_id")
  cuit            String    @unique
  razonSocial     String    @map("razon_social")
  address         String?
  commissionRate  Decimal   @default(0.15) @map("commission_rate") @db.Decimal(5, 4)
  afipValidatedAt DateTime? @map("afip_validated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders             Order[]
  walletTransactions WalletTransaction[]
  depositRequests    DepositRequest[]
  withdrawalRequests WithdrawalRequest[]
  bankAccounts       BankAccount[]
  shopifyConnections ShopifyConnection[]

  @@map("dropshipper_profiles")
}

// ============================================================
// Suppliers & Warehouses
// ============================================================

model Supplier {
  id           String         @id @default(cuid())
  code         String         @unique
  name         String
  cuit         String?
  contactEmail String?        @map("contact_email")
  status       SupplierStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  products   Product[]
  warehouses Warehouse[]

  @@map("suppliers")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Warehouse {
  id             String   @id @default(cuid())
  supplierId     String   @map("supplier_id")
  name           String
  address        String
  operatingHours String?  @map("operating_hours")
  capacity       Int?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("warehouses")
}

// ============================================================
// Products
// ============================================================

model Product {
  id                String            @id @default(cuid())
  sku               String            @unique
  name              String
  description       String?           @db.Text
  costPrice         Decimal           @map("cost_price") @db.Decimal(12, 2)
  suggestedPrice    Decimal           @map("suggested_price") @db.Decimal(12, 2)
  stock             Int               @default(0)
  lowStockThreshold Int               @default(10) @map("low_stock_threshold")
  weight            Decimal?          @db.Decimal(10, 2)
  dimensions        Json?
  supplierId        String            @map("supplier_id")
  visibilityType    ProductVisibility @default(PUBLIC) @map("visibility_type")
  imagesUrls        String[]          @default([]) @map("images_urls")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relations
  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([sku])
  @@index([supplierId])
  @@index([stock])
  @@map("products")
}

enum ProductVisibility {
  PUBLIC
  PRIVATE
  HIDDEN
}

// ============================================================
// Orders
// ============================================================

model Order {
  id               String      @id @default(cuid())
  dropshipperId    String      @map("dropshipper_id")
  shopifyOrderId   String?     @unique @map("shopify_order_id")
  storeId          String?     @map("store_id")
  customerName     String      @map("customer_name")
  customerEmail    String?     @map("customer_email")
  shippingAddress  Json        @map("shipping_address")
  paymentType      PaymentType @map("payment_type")
  state            OrderState  @default(PENDING)
  totalAmount      Decimal     @map("total_amount") @db.Decimal(12, 2)
  productCost      Decimal     @map("product_cost") @db.Decimal(12, 2)
  shippingCost     Decimal     @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  commissionAmount Decimal     @map("commission_amount") @db.Decimal(12, 2)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  // Relations
  dropshipper        DropshipperProfile  @relation(fields: [dropshipperId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  events             OrderEvent[]
  walletTransactions WalletTransaction[]

  @@index([dropshipperId])
  @@index([state])
  @@index([createdAt])
  @@index([shopifyOrderId])
  @@map("orders")
}

enum PaymentType {
  TC // Credit Card
  COD // Cash on Delivery
}

enum OrderState {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model OrderEvent {
  id              String      @id @default(cuid())
  orderId         String      @map("order_id")
  fromState       OrderState? @map("from_state")
  toState         OrderState  @map("to_state")
  changedByUserId String      @map("changed_by_user_id")
  reason          String?     @db.Text
  metadata        Json?
  createdAt       DateTime    @default(now()) @map("created_at")

  // Relations
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User  @relation("ChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_events")
}

// ============================================================
// Wallet & Financial Transactions
// ============================================================

model WalletTransaction {
  id              String          @id @default(cuid())
  dropshipperId   String          @map("dropshipper_id")
  type            TransactionType
  debitAmount     Decimal         @default(0) @map("debit_amount") @db.Decimal(12, 2)
  creditAmount    Decimal         @default(0) @map("credit_amount") @db.Decimal(12, 2)
  balanceAfter    Decimal         @map("balance_after") @db.Decimal(12, 2)
  orderId         String?         @map("order_id")
  description     String          @db.Text
  createdByUserId String          @map("created_by_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  // Relations
  dropshipper DropshipperProfile @relation(fields: [dropshipperId], references: [id], onDelete: Restrict)
  order       Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy   User               @relation("CreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([dropshipperId])
  @@index([createdAt])
  @@index([type])
  @@map("wallet_transactions")
}

enum TransactionType {
  SALE_COMMISSION
  DEPOSIT
  WITHDRAWAL
  REFUND
  ADJUSTMENT
}

model DepositRequest {
  id               String        @id @default(cuid())
  dropshipperId    String        @map("dropshipper_id")
  amount           Decimal       @db.Decimal(12, 2)
  receiptUrl       String?       @map("receipt_url")
  observations     String?       @db.Text
  status           DepositStatus @default(PENDING)
  reviewedByUserId String?       @map("reviewed_by_user_id")
  reviewedAt       DateTime?     @map("reviewed_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  dropshipper DropshipperProfile @relation(fields: [dropshipperId], references: [id], onDelete: Restrict)
  reviewedBy  User?              @relation("ReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([dropshipperId])
  @@index([status])
  @@index([createdAt])
  @@map("deposit_requests")
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

model WithdrawalRequest {
  id               String           @id @default(cuid())
  dropshipperId    String           @map("dropshipper_id")
  amount           Decimal          @db.Decimal(12, 2)
  bankAccountId    String           @map("bank_account_id")
  status           WithdrawalStatus @default(PENDING)
  reviewedByUserId String?          @map("reviewed_by_user_id")
  reviewedAt       DateTime?        @map("reviewed_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  dropshipper DropshipperProfile @relation(fields: [dropshipperId], references: [id], onDelete: Restrict)
  bankAccount BankAccount        @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  reviewedBy  User?              @relation("ReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([dropshipperId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawal_requests")
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model BankAccount {
  id            String    @id @default(cuid())
  dropshipperId String    @map("dropshipper_id")
  cbu           String
  alias         String?
  accountHolder String    @map("account_holder")
  accountType   String    @map("account_type")
  bankName      String    @map("bank_name")
  validatedAt   DateTime? @map("validated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  dropshipper        DropshipperProfile  @relation(fields: [dropshipperId], references: [id], onDelete: Cascade)
  withdrawalRequests WithdrawalRequest[]

  @@unique([dropshipperId, cbu])
  @@map("bank_accounts")
}

// ============================================================
// Shopify Integration
// ============================================================

model ShopifyConnection {
  id            String        @id @default(cuid())
  dropshipperId String        @map("dropshipper_id")
  shopDomain    String        @map("shop_domain")
  accessToken   String        @map("access_token")
  status        ShopifyStatus @default(ACTIVE)
  lastSyncAt    DateTime?     @map("last_sync_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  dropshipper DropshipperProfile @relation(fields: [dropshipperId], references: [id], onDelete: Cascade)

  @@unique([dropshipperId, shopDomain])
  @@index([dropshipperId])
  @@map("shopify_connections")
}

enum ShopifyStatus {
  ACTIVE
  INACTIVE
  ERROR
}

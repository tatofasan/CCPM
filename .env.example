# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ccpm_dropshipping?schema=public"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-at-least-32-characters-long"
JWT_EXPIRES_IN="24h"
REFRESH_TOKEN_SECRET="your-super-secret-refresh-token-key-at-least-32-characters-long"

# Redis
REDIS_URL="redis://localhost:6379"

# Node environment
NODE_ENV="development"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
